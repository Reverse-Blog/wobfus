---
import "../style.css";
import trident from "../../trident.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="A simple JavaScript pseudo-obfuscation demo"
    />
    <link rel="icon" type="image/png" href={trident.src} />
    <title>Wobfus — JavaScript obfuscator demo</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      fetch("https://visitor.reverse.blog", {
        method: "POST",
        headers: { "Content-Type": "text/plain;charset=UTF-8" },
        body: JSON.stringify({
          url: window.location.href,
          languages: navigator.languages,
          referrer: document.referrer ? new URL(document.referrer).origin : "",
        }),
        keepalive: true,
      })
        .then((response) => {
          if (!response.ok) console.error("Visitor notification failed:", response.status);
        })
        .catch(() => console.error("Could not reach the visitor Worker."));
    </script>
  </body>
</html>
