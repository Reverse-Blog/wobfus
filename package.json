{
  "name": "wobfus",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "build": "npm run build:package && npm run build:site",
    "build:package": "vite build && tsc --emitDeclarationOnly",
    "build:site": "astro build",
    "check": "astro sync && tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "test": "node --test",
    "prepare": "npm run build:package",
    "prepublishOnly": "npm test && npm run check"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "devDependencies": {
    "astro": "^7.4.12",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.9.10",
    "terser": "^5.43.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@babel/generator": "^8.1.0",
    "@babel/parser": "^8.1.0",
    "@babel/traverse": "^8.1.0",
    "@babel/types": "^8.1.0"
  }
}
